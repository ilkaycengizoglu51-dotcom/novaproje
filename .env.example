# Sitenin adresi (e-postalardaki bağlantılar için)
SITE_URL=https://www.novaproje.com
# PostgreSQL bağlantısı (Neon, Supabase, Vercel Postgres vb.)
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/novaproje
# Yerel veritabanında SSL kullanmıyorsanız false yapın
DATABASE_SSL=true
# İlk yönetici hesabı (npm run db:init)
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=
ADMIN_NAME=NOVAPROJE Yönetim
ADMIN_EMAIL=info@novaproje.com
# E-posta bildirimleri (isteğe bağlı): Resend API anahtarı ve gönderen adresi
RESEND_API_KEY=
MAIL_FROM=NOVAPROJE <bildirim@novaproje.com>
# Bildirimlerin yönetici tarafında gideceği adres
ADMIN_NOTIFY_EMAIL=info@novaproje.com
